SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
BASH_ENV=/tmp/cron.env

# Segments Update - every 15 min
0,15,30,45 * * * * php /var/www/html/bin/console mautic:segments:update 2>&1 | tee /tmp/stdout

# Campaigns Update - every 15 min starting at 5 past the hour
5,20,35,50 * * * * php /var/www/html/bin/console mautic:campaigns:update 2>&1 | tee /tmp/stdout

# Trigger Update - every 15 min starting at 10 past the hour
10,25,40,55 * * * * php /var/www/html/bin/console mautic:campaigns:trigger 2>&1 | tee /tmp/stdout

# E-mails de segment programmés - toutes les 5 min. Seule une date de publication
# passée déclenche un envoi : un e-mail de segment publié sans date n'est jamais
# traité (allowNullForPublishedUp à faux dans EmailRepository). --channel=email
# limite la tâche aux e-mails.
*/5 * * * * php /var/www/html/bin/console mautic:broadcasts:send --channel=email 2>&1 | tee /tmp/stdout

# SMS de segment programmés - toutes les 5 min, deux minutes après les e-mails.
# Sans cette tâche, un SMS de type segment restait en attente pour toujours.
# Même règle que les e-mails : seul un SMS de segment publié avec une date passée
# part (getPublishedBroadcastsQuery dans SmsRepository) ; les contacts désinscrits
# des SMS, déjà servis ou en file sont écartés (BroadcastQuery du SmsBundle). Les
# SMS placés dans un scénario ne passent pas par ici (mautic:campaigns:trigger).
# Le verrou de la commande porte le nom du canal : cette tâche et celle des
# e-mails ne se bloquent pas.
2-59/5 * * * * php /var/www/html/bin/console mautic:broadcasts:send --channel=sms 2>&1 | tee /tmp/stdout

# E-mails retenus par le rythme choisi par le contact - toutes les 15 min, décalé
# des tâches ci-dessus. Le plafond, la pause et le désabonnement sont relus à
# chaque tentative.
3,18,33,48 * * * * php /var/www/html/bin/console mautic:messages:send 2>&1 | tee /tmp/stdout

# Monitored E-mail - every 1 min
#* * * * * php /var/www/html/bin/console mautic:email:fetch 2>&1 | tee /tmp/stdout

# Social Monitoring - every 6 min
#*/6 * * * * php /var/www/html/bin/console mautic:social:monitoring 2>&1 | tee /tmp/stdout

# Import Contacts - every 3 min - fix 269
#*/3 * * * * php /var/www/html/bin/console mautic:import 2>&1 | tee /tmp/stdout

# Export Contacts - every 3 min
#*/3 * * * * php /var/www/html/bin/console mautic:contacts:scheduled_export 2>&1 | tee /tmp/stdout

# Webhooks - every 1 min
#* * * * * php /var/www/html/bin/console mautic:webhooks:process 2>&1 | tee /tmp/stdout

# Update MaxMind GeoLite2 IP database - every hour - fix 171
#0 * * * * php /var/www/html/bin/console mautic:iplookup:download 2>&1 | tee /tmp/stdout

# Purge des visiteurs ANONYMES - at 02:01
# Réactivée pour Sendly (2026-07-21). La prudence upstream (« MAY CAUSE
# DATALOSS ») est sans objet ici : SANS --gdpr, mautic:maintenance:cleanup
# ne supprime QUE les contacts anonymes (cf. l'aide de la commande) — la
# population que ni le quota ni les KPI ne comptent (contacts identifiés
# seuls, décisions produit 2026-07-20/21). Sans purge, le tracking web
# accumule les visiteurs sans limite : bases gonflées, sauvegardes
# alourdies, listes polluées. 30 jours = fenêtre de conversion
# anonyme -> identifié préservée. Ne JAMAIS ajouter --gdpr ici : ce flag
# étend la purge aux contacts IDENTIFIÉS inactifs.
1 2 * * * php /var/www/html/bin/console mautic:maintenance:cleanup --days-old=30 -n 2>&1 | tee /tmp/stdout

